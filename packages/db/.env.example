# Postgres connection string. Filled in for local development: this is the
# database `pnpm supabase:start` serves, on the port `supabase/config.toml`
# names.
#
# In a deployment, Supabase gives you two: use the transaction-mode pooler for
# serverless deploys and the direct connection for long-running servers.
# src/connection/client.ts sets `prepare: false` so either works.
#
# NOTE: apps/web/.env needs this same value. Keep the two in sync — the web
# server reads its own .env, this one is only used by drizzle-kit commands.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional. Point the test suite at a real Postgres instead of the in-process
# PGlite one. The tests themselves do not change.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/test
