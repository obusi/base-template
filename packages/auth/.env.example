# These two are read by whichever process imports this package — today that is
# `next dev` in apps/web, so the real values belong in apps/web/.env, not here.
# This file exists so the requirement is visible from inside the package that
# actually needs it.

# Signs and encrypts session tokens. Generate a fresh one per environment:
#   openssl rand -base64 32
# Never reuse the development value in production.
BETTER_AUTH_SECRET=

# Where the app is served from. Better Auth builds callback and email links
# from it, so it has to match the browser's address bar exactly.
BETTER_AUTH_URL=http://localhost:3000
