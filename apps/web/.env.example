# Copy to `.env` and fill in. This is the only .env the running app reads:
# `next dev` starts here, so this directory is where it looks.

# Postgres connection string. Must match packages/db/.env, which drizzle-kit
# reads for migrations — they are two processes pointed at one database.
DATABASE_URL=

# Signs and encrypts session tokens. Generate a fresh one per environment:
#   openssl rand -base64 32
# Better Auth falls back to a hard-coded default when this is missing, so
# packages/auth/src/env.ts refuses to start without it.
BETTER_AUTH_SECRET=

# Where the app is served from. Better Auth builds callback and email links
# from it, so it has to match the browser's address bar exactly.
BETTER_AUTH_URL=http://localhost:3000

# Optional, and only for deployments reachable at more than one hostname —
# preview deployments, whose hostname changes with every build. Comma-separated,
# wildcards allowed. Leave empty here and in production, where BETTER_AUTH_URL
# above is the whole answer.
#   BETTER_AUTH_ALLOWED_HOSTS=myapp-*.vercel.app
# Keep the patterns narrow. `*.vercel.app` is every Vercel deployment on earth,
# not just this project's.
BETTER_AUTH_ALLOWED_HOSTS=

# Optional. Without it, password-reset links are written to the server log
# instead of emailed — usable while developing, and a silent failure in
# production. Get one from https://resend.com.
RESEND_API_KEY=

# Only read when RESEND_API_KEY is set. Defaults to Resend's sandbox address,
# which delivers only to the address that owns the Resend account. Change it to
# something on your own verified domain before real users see it.
RESEND_FROM=onboarding@resend.dev

# Optional, and only take effect together. The button is always rendered; until
# both are set it answers PROVIDER_NOT_FOUND on click, which is deliberate —
# see features/auth/components/social-buttons.tsx. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and register this exact
# redirect URI on it: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
