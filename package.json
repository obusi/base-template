{
  "name": "base-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "seed": "pnpm --filter @packages/scripts seed",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset && pnpm db:migrate",
    "db:generate": "pnpm --filter @packages/db db:generate",
    "db:migrate": "pnpm --filter @packages/db db:migrate",
    "db:studio": "pnpm --filter @packages/db db:studio",
    "db:check": "pnpm --filter @packages/db db:check",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "turbo typecheck lint test && pnpm format:check"
  },
  "devDependencies": {
    "@tooling/eslint-config": "workspace:*",
    "@tooling/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.116.0",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}
